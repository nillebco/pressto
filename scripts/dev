#!/bin/sh
#
# Build the fork, then install and (re)launch it.
#
# Usage:
#
#   scripts/dev            build, then open the app
#   scripts/dev --install  build, copy to /Applications, then open that copy
#   scripts/dev --dump     build, then run with SCOOT_DUMP_ELEMENTS=1, so every
#                          element-mode invoke writes an accessibility dump to
#                          ~/Library/Application Support/Pressto/element-dumps/
#
# Notes:
#
# - Signing with an Apple Development identity keeps the Accessibility (TCC)
#   grant across rebuilds. The Xcode build itself signs ad-hoc (the project has
#   no provisioning profile), and an ad-hoc signature changes on every build, so
#   the app is re-signed here after building. Without an Apple Development
#   identity, a self-signed "Pressto Local Signing" certificate in the login
#   keychain works too (scripts/make-signing-cert creates it): the grant is
#   tied to the certificate, which need not be trusted. Passing the identity to xcodebuild
#   instead fails on the KeyboardShortcuts resource bundle, which has no team.
# - The bundle identifier is co.nillebco.pressto, so this build and a Scoot
#   installed from Homebrew keep separate Accessibility entries.

set -eu

ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"

IDENTITY=${SCOOT_SIGN_IDENTITY:-}
if [ -z "$IDENTITY" ]; then
    IDENTITY=$(security find-identity -v -p codesigning 2>/dev/null \
        | sed -n 's/.*"\(Apple Development.*\)"/\1/p' | head -1)
fi
if [ -z "$IDENTITY" ] && security find-identity -p codesigning 2>/dev/null | grep -q '"Pressto Local Signing"'; then
    IDENTITY="Pressto Local Signing"
fi

APP=".build/Build/Products/Debug/Pressto.app"

xcodebuild \
    -project Scoot.xcodeproj \
    -scheme Scoot \
    -configuration Debug \
    -derivedDataPath .build \
    build

if [ -n "$IDENTITY" ]; then
    codesign --force --sign "$IDENTITY" "$APP"
else
    echo "warning: no signing identity found; the app stays ad-hoc signed." >&2
    echo "         Run scripts/make-signing-cert once to create a local one." >&2
fi

if codesign -dv "$APP" 2>&1 | grep -q "Signature=adhoc"; then
    echo "warning: $APP is still ad-hoc signed; macOS will ask for Accessibility again" >&2
    echo "         after each rebuild. Run scripts/make-signing-cert, or set SCOOT_SIGN_IDENTITY." >&2
fi

# Stop any previous instance; the executable path is what distinguishes this
# build from a Homebrew install in /Applications.
pkill -f "Products/Debug/(Scoot|Pressto).app/Contents/MacOS/" 2>/dev/null || true
sleep 0.5

if [ "${1:-}" = "--install" ]; then
    pkill -f "/Applications/Pressto.app/Contents/MacOS/" 2>/dev/null || true
    sleep 0.5
    rm -rf /Applications/Pressto.app
    ditto "$APP" /Applications/Pressto.app
    open /Applications/Pressto.app
    exit 0
fi

if [ "${1:-}" = "--dump" ]; then
    echo "Launching with SCOOT_DUMP_ELEMENTS=1"
    SCOOT_DUMP_ELEMENTS=1 "$ROOT/$APP/Contents/MacOS/Pressto" &
    exit 0
fi

open "$ROOT/$APP"
