#!/bin/sh
#
# Build a Developer ID signed, notarized and stapled Pressto.zip.
#
# Usage:
#
#   scripts/release 1.0            build, sign, notarize -> dist/Pressto-1.0.zip
#   scripts/release 1.0 --publish  same, then create the GitHub release v1.0
#
# One-time setup:
#
# - A "Developer ID Application" certificate in the login keychain (Xcode →
#   Settings → Accounts → Manage Certificates → + → Developer ID Application;
#   needs the Account Holder role on the team).
# - notarytool credentials stored under the profile "pressto-notary":
#     xcrun notarytool store-credentials pressto-notary \
#         --apple-id <apple id> --team-id <team> --password <app-specific password>
#   Override with PRESSTO_NOTARY_PROFILE.

set -eu

VERSION=${1:?usage: scripts/release <version> [--publish]}
PUBLISH=${2:-}

ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"

PROFILE=${PRESSTO_NOTARY_PROFILE:-pressto-notary}
IDENTITY=${PRESSTO_SIGN_IDENTITY:-}
if [ -z "$IDENTITY" ]; then
    IDENTITY=$(security find-identity -v -p codesigning 2>/dev/null \
        | sed -n 's/.*"\(Developer ID Application.*\)"/\1/p' | head -1)
fi
if [ -z "$IDENTITY" ]; then
    echo "error: no Developer ID Application identity in the keychain" >&2
    exit 1
fi

if [ -n "$(git status --porcelain)" ]; then
    echo "error: the working tree has uncommitted changes" >&2
    exit 1
fi

BUILD=.build-release
APP="$BUILD/Build/Products/Release/Pressto.app"
DIST=dist
ZIP="$DIST/Pressto-$VERSION.zip"

rm -rf "$BUILD" "$DIST"
mkdir -p "$DIST"

xcodebuild \
    -project Scoot.xcodeproj \
    -scheme Scoot \
    -configuration Release \
    -derivedDataPath "$BUILD" \
    MARKETING_VERSION="$VERSION" \
    CURRENT_PROJECT_VERSION="$(git rev-list --count HEAD)" \
    build

# Sign nested code first, then the app. Resource-only bundles (such as
# KeyboardShortcuts') are sealed as resources of the app and need no signature
# of their own.
if [ -d "$APP/Contents/Frameworks" ]; then
    find "$APP/Contents/Frameworks" -depth \( -name '*.framework' -o -name '*.dylib' \) \
        -exec codesign --force --options runtime --timestamp --sign "$IDENTITY" {} \;
fi
codesign --force --options runtime --timestamp \
    --entitlements Scoot/Scoot.entitlements \
    --sign "$IDENTITY" "$APP"
codesign --verify --strict --deep --verbose=2 "$APP"

ditto -c -k --keepParent "$APP" "$ZIP"
xcrun notarytool submit "$ZIP" --keychain-profile "$PROFILE" --wait
xcrun stapler staple "$APP"
spctl --assess --type execute --verbose "$APP"

# Re-zip so the download carries the stapled ticket (works offline).
rm "$ZIP"
ditto -c -k --keepParent "$APP" "$ZIP"
shasum -a 256 "$ZIP"

if [ "$PUBLISH" = "--publish" ]; then
    git tag -a "v$VERSION" -m "Pressto $VERSION"
    git push origin "v$VERSION"
    gh release create "v$VERSION" "$ZIP" --title "Pressto $VERSION" --generate-notes
fi
