#!/bin/sh
#
# Build a Developer ID signed, notarized and stapled Pressto.zip.
#
# Usage:
#
#   scripts/release 1.0            build, sign, notarize -> dist/Pressto-1.0.zip
#   scripts/release 1.0 --publish  same, then create the GitHub release v1.0
#
# One-time setup, local machine:
#
# - A "Developer ID Application" certificate in the login keychain, obtained by
#   uploading a CSR to the developer portal (Xcode's Manage Certificates menu
#   returns "This operation can only be performed by the Account Holder" on
#   organisation teams even for the Account Holder).
# - notarytool credentials stored under the profile "pressto-notary":
#     xcrun notarytool store-credentials pressto-notary \
#         --apple-id <apple id> --team-id <team>
#   Override with PRESSTO_NOTARY_PROFILE.
#
# CI (see .github/workflows/release.yml) instead supplies:
#
# - PRESSTO_SIGN_IDENTITY   the imported identity name, e.g.
#                           "Developer ID Application: nillebco (S8T2KKG4YP)".
# - PRESSTO_NOTARY_KEY      path to the App Store Connect API key (.p8).
# - PRESSTO_NOTARY_KEY_ID   its Key ID.
# - PRESSTO_NOTARY_ISSUER   its Issuer ID (Team keys only).
#
# When the API key variables are set the keychain profile is not used, so no
# interactive keychain access is needed.

set -eu

VERSION=${1:?usage: scripts/release <version> [--publish]}
PUBLISH=${2:-}

ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"

# GitHub repository to publish to, always derived from origin: this checkout
# also has an "upstream" remote pointing at mjrusso/scoot, which is what bare
# gh commands resolve to (they fail on --verify-tag or target the wrong repo).
REMOTE=$(git remote get-url origin 2>/dev/null || echo '')
REPO=$(printf '%s' "$REMOTE" | sed -e 's#^.*github\.com[:/]##' -e 's#\.git$##')

PROFILE=${PRESSTO_NOTARY_PROFILE:-pressto-notary}
IDENTITY=${PRESSTO_SIGN_IDENTITY:-}
if [ -z "$IDENTITY" ]; then
    IDENTITY=$(security find-identity -v -p codesigning 2>/dev/null \
        | sed -n 's/.*"\(Developer ID Application.*\)"/\1/p' | head -1)
fi
if [ -z "$IDENTITY" ]; then
    echo "error: no Developer ID Application identity in the keychain" >&2
    exit 1
fi

if [ -n "$(git status --porcelain)" ]; then
    echo "error: the working tree has uncommitted changes" >&2
    exit 1
fi

BUILD=.build-release
APP="$BUILD/Build/Products/Release/Pressto.app"
DIST=dist
ZIP="$DIST/Pressto-$VERSION.zip"

rm -rf "$BUILD" "$DIST"
mkdir -p "$DIST"

xcodebuild \
    -project Scoot.xcodeproj \
    -scheme Scoot \
    -configuration Release \
    -derivedDataPath "$BUILD" \
    MARKETING_VERSION="$VERSION" \
    CURRENT_PROJECT_VERSION="$(git rev-list --count HEAD)" \
    build

# Sign nested code first, then the app. Resource-only bundles (such as
# KeyboardShortcuts') are sealed as resources of the app and need no signature
# of their own.
if [ -d "$APP/Contents/Frameworks" ]; then
    find "$APP/Contents/Frameworks" -depth \( -name '*.framework' -o -name '*.dylib' \) \
        -exec codesign --force --options runtime --timestamp --sign "$IDENTITY" {} \;
fi
codesign --force --options runtime --timestamp \
    --entitlements Scoot/Scoot.entitlements \
    --sign "$IDENTITY" "$APP"
codesign --verify --strict --deep --verbose=2 "$APP"

ditto -c -k --keepParent "$APP" "$ZIP"

# Local runs read the keychain profile; CI passes an App Store Connect API key,
# which notarytool reads straight from the .p8 file.
if [ -n "${PRESSTO_NOTARY_KEY:-}" ]; then
    set -- --key "$PRESSTO_NOTARY_KEY" --key-id "${PRESSTO_NOTARY_KEY_ID:?PRESSTO_NOTARY_KEY_ID is required with PRESSTO_NOTARY_KEY}"
    if [ -n "${PRESSTO_NOTARY_ISSUER:-}" ]; then
        set -- "$@" --issuer "$PRESSTO_NOTARY_ISSUER"
    fi
    xcrun notarytool submit "$ZIP" "$@" --wait
else
    xcrun notarytool submit "$ZIP" --keychain-profile "$PROFILE" --wait
fi

xcrun stapler staple "$APP"
spctl --assess --type execute --verbose "$APP"

# Re-zip so the download carries the stapled ticket (works offline).
rm "$ZIP"
ditto -c -k --keepParent "$APP" "$ZIP"
shasum -a 256 "$ZIP"

if [ "$PUBLISH" = "--publish" ]; then
    # In CI the tag is what triggered the run, so it already exists and pushing
    # it again would fail.
    if git rev-parse -q --verify "refs/tags/v$VERSION" >/dev/null; then
        echo "tag v$VERSION already exists"
    else
        git tag -a "v$VERSION" -m "Pressto $VERSION"
        git push origin "v$VERSION"
    fi
    gh release create "v$VERSION" "$ZIP" --repo "$REPO" --verify-tag \
        --title "Pressto $VERSION" --generate-notes
fi
