#!/bin/sh
#
# Create the self-signed code-signing certificate that scripts/dev falls back
# to when there is no valid Apple Development identity.
#
# Usage:
#
#   scripts/make-signing-cert
#
# Why: macOS ties the Accessibility grant to the app's code signature. An
# ad-hoc signature changes on every build, so each rebuild asks for access
# again. Signed with a fixed certificate, the grant survives rebuilds. The
# certificate does not need to be trusted for that, so nothing is added to the
# trust settings and no password is asked.
#
# The private key is generated locally, imported into the login keychain (or
# $KEYCHAIN), and its temporary copy is deleted. Running the script again does
# nothing if the certificate already exists. To remove it:
#
#   security delete-identity -c "Pressto Local Signing"

set -eu

NAME="Pressto Local Signing"
KEYCHAIN=${KEYCHAIN:-"$HOME/Library/Keychains/login.keychain-db"}

if security find-identity -p codesigning "$KEYCHAIN" 2>/dev/null | grep -q "\"$NAME\""; then
    echo "\"$NAME\" already exists in $KEYCHAIN; nothing to do."
    exit 0
fi

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

cat > "$WORK/cert.cnf" <<EOF
[req]
distinguished_name = dn
x509_extensions = ext
prompt = no
[dn]
CN = $NAME
[ext]
basicConstraints = critical, CA:false
keyUsage = critical, digitalSignature
extendedKeyUsage = critical, codeSigning
EOF

openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
    -keyout "$WORK/key.pem" -out "$WORK/cert.pem" -config "$WORK/cert.cnf" 2>/dev/null

# `security import` reads only the older PKCS#12 algorithms. OpenSSL 3+ needs
# -legacy for them; LibreSSL (/usr/bin/openssl on macOS) has no such flag and
# uses them by default.
PASSWORD=$(openssl rand -hex 16)
if ! openssl pkcs12 -export -legacy -inkey "$WORK/key.pem" -in "$WORK/cert.pem" \
        -name "$NAME" -out "$WORK/identity.p12" -passout "pass:$PASSWORD" 2>/dev/null; then
    openssl pkcs12 -export -inkey "$WORK/key.pem" -in "$WORK/cert.pem" \
        -name "$NAME" -out "$WORK/identity.p12" -passout "pass:$PASSWORD"
fi

# -T lets codesign use the key without a keychain prompt on every build.
security import "$WORK/identity.p12" -k "$KEYCHAIN" -P "$PASSWORD" -T /usr/bin/codesign >/dev/null

echo "Created \"$NAME\" in $KEYCHAIN (valid 10 years)."
echo "scripts/dev now signs with it. Grant Accessibility once more after the next build;"
echo "later builds keep the grant."
